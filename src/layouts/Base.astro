---
import '@fontsource/mitr/latin-500.css';
import '@fontsource/mitr/thai-500.css';
import '@fontsource/mitr/latin-600.css';
import '@fontsource/mitr/thai-600.css';
import '@fontsource/anuphan/thai-400.css';
import '@fontsource/anuphan/thai-500.css';
import '@fontsource/anuphan/thai-600.css';
import '@fontsource/anuphan/thai-700.css';
import '@fontsource/atkinson-hyperlegible-next/latin-400.css';
import '@fontsource/atkinson-hyperlegible-next/latin-500.css';
import '@fontsource/atkinson-hyperlegible-next/latin-600.css';
import '@fontsource/atkinson-hyperlegible-next/latin-700.css';
import '@fontsource/atkinson-hyperlegible-mono/latin-400.css';
import '@fontsource/atkinson-hyperlegible-mono/latin-500.css';
import '../styles/global.css';
import type { Lang, LivePage } from '../data/types';
import { absoluteUrl, alternates, pagePath } from '../lib/seo';
import { isProduction, currentContact } from '../lib/env';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';

interface Props { lang: Lang; page: LivePage; jsonLd: object }
const { lang, page, jsonLd } = Astro.props;

// A production build without a contact address must fail, on every page.
currentContact();

const env = import.meta.env as Record<string, string | undefined>;
const indexable = page.indexable && isProduction(env);
const canonical = absoluteUrl(pagePath(lang, page.slug));
const title = page.title[lang];
const description = page.description[lang];
const beacon = env.PUBLIC_CF_BEACON_TOKEN;
// "<" escaped so the JSON can never close the script tag.
const ld = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? 'index, follow' : 'noindex, nofollow'} />
    <link rel="canonical" href={canonical} />
    {alternates(page.slug).map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="mailmeow" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'th' ? 'th_TH' : 'en_US'} />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script type="application/ld+json" set:html={ld} />
    {beacon && <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: beacon })}></script>}
  </head>
  <body>
    <SiteNav lang={lang} slug={page.slug} />
    <main>
      <slot />
    </main>
    <SiteFooter lang={lang} slug={page.slug} />
  </body>
</html>
