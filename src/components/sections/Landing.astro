---
import { LANDING, WHAT_IS } from '../../data/copy/landing';
import type { Lang } from '../../data/types';
import Rich from '../Rich.astro';
import FaqList from '../FaqList.astro';
import WaitlistForm from '../WaitlistForm.astro';
import Icon from '../Icon.astro';
interface Props { lang: Lang }
const { lang } = Astro.props;
const L = LANDING;
const D = L.hero.demo;
const ICON = { queued: 'clock', sent: 'sent', delivered: 'check' } as const;
// "**Title** rest" -> title and rest, so each AI item can sit as a row (title column, text column).
const splitItem = (t: string) => {
  const m = /^\*\*(.+?)\*\*\s*(.*)$/s.exec(t);
  return m ? { title: m[1]!, rest: m[2]! } : { title: '', rest: t };
};
---
<section class="hero" aria-labelledby="hero-h">
  <div class="hero-copy">
    <h1 id="hero-h"><Rich text={L.hero.h1[lang]} lang={lang} /></h1>
    <p class="lede">{L.hero.sub[lang]}</p>
    <div class="cta-row">
      <a class="btn btn-primary btn-lg" href="#waitlist">{L.hero.cta[lang]}</a>
      <p class="under-cta">{L.hero.underCta[lang]}</p>
    </div>
  </div>

  <figure class="hero-demo" aria-label={D.label[lang]}>
    <!-- Mascot slot (DESIGN.md): pixel portrait at a whole-number scale, peeking over the card. -->
    <img class="mascot" src="/mailmeow-portrait@4x.png" alt="" width="128" height="128" />
    <div class="demo-card">
      <div class="demo-head">
        <p class="demo-subject">{D.subject[lang]}</p>
        <span class="demo-tag">{D.tag[lang]}</span>
      </div>
      <p class="demo-to"><span class="muted">{D.to[lang]}</span> <span class="mono">ploy@example.com</span></p>
      <ol class="trail">
        {D.events.map((e, i) => (
          <li class={`trail-item is-${e.status}`} style={`--i: ${i}`}>
            <span class="trail-dot"><Icon name={ICON[e.status]} /></span>
            <span class="trail-label">{e.label[lang]}</span>
            <span class="trail-detail">{e.detail[lang]}</span>
            <time class="trail-time mono">{e.time}</time>
          </li>
        ))}
      </ol>
    </div>
    <p class="note demo-note">{D.note[lang]}</p>
  </figure>
</section>

<section class="section" aria-labelledby="problem-h">
  <h2 id="problem-h">{L.problem.heading[lang]}</h2>
  <div class="versus">
    <p class="versus-label versus-now" aria-hidden="true">{L.problem.nowLabel[lang]}</p>
    <p class="versus-label versus-fix" aria-hidden="true">{L.problem.fixLabel[lang]}</p>
    {L.problem.rows.map((r) => (
      <Fragment>
        <p class="versus-now"><Icon name="x" /><span><span class="sr-only">{L.problem.nowLabel[lang]}: </span>{r.now[lang]}</span></p>
        <p class="versus-fix"><Icon name="check" /><span><span class="sr-only">{L.problem.fixLabel[lang]}: </span>{r.fix[lang]}</span></p>
      </Fragment>
    ))}
  </div>
</section>

<section class="section" aria-labelledby="ai-h">
  <h2 id="ai-h">{L.aiCoding.heading[lang]}</h2>
  <ul class="rows">
    {L.aiCoding.items.map((item) => {
      const { title, rest } = splitItem(item[lang]);
      return (
        <li>
          <h3>{title}</h3>
          <p><Rich text={rest} lang={lang} /></p>
        </li>
      );
    })}
  </ul>
</section>

<section class="section" id="how" aria-labelledby="steps-h">
  <h2 id="steps-h">{L.steps.heading[lang]}</h2>
  <ol class="steps">
    {L.steps.items.map((s, i) => (
      <li>
        <span class="step-n" aria-hidden="true">{i + 1}</span>
        <h3>{s.title[lang]}</h3>
        <p>{s.body[lang]}</p>
      </li>
    ))}
  </ol>
</section>

<section class="section" aria-labelledby="biz-h">
  <h2 id="biz-h">{L.business.heading[lang]}</h2>
  <ul class="plain-list">
    {L.business.items.map((item) => <li><Rich text={item[lang]} lang={lang} /></li>)}
  </ul>
</section>

<section class="section" id="pricing" aria-labelledby="pricing-h">
  <h2 id="pricing-h">{L.pricing.heading[lang]}</h2>
  <p class="prose">{L.pricing.intro[lang]}</p>
  <div class="card-grid plans">
    {L.pricing.plans.map((plan) => (
      <div class="card plan">
        <h3>{plan.name[lang]}</h3>
        <p class="plan-price"><Rich text={plan.price[lang]} lang={lang} /></p>
        <ul>
          {plan.lines.map((line) => <li>{line[lang]}</li>)}
        </ul>
      </div>
    ))}
  </div>
  <p class="prose"><strong>{L.pricing.allPlans[lang]}</strong></p>
  <p class="prose">{L.pricing.thbNote[lang]}</p>
</section>

<section class="section" id="faq" aria-labelledby="faq-h">
  <h2 id="faq-h">{L.faqHeading[lang]}</h2>
  <FaqList items={L.faq} lang={lang} />
</section>

<section class="section" aria-labelledby="what-h">
  <h2 id="what-h">{L.whatIsHeading[lang]}</h2>
  <p class="prose what-is">{WHAT_IS[lang]}</p>
</section>

<section class="section" id="waitlist" aria-labelledby="final-h">
  <h2 id="final-h">{L.finalCta.heading[lang]}</h2>
  <WaitlistForm lang={lang} />
</section>
